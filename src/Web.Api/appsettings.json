{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpOverrides": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "WindowSeconds": 60,
    "Session": {
      "Reads": 300,
      "Writes": 150,
      "Heavy": 20
    },
    "Ip": {
      "Total": 600,
      "Heavy": 60,
      "NewSessions": 10
    }
  },
  "ForwardedHeaders": {
    "TrustedNetworks": []
  },
  "Allocation": {
    "LockWaitMilliseconds": 5000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Demo": {
    "ResetKey": "",
    "LockMasterDataDeletion": false
  },
  "Control": {
    "OperatingHours": {
      "Start": "06:00",
      "End": "22:00",
      "Bases": {}
    }
  }
}
