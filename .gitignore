#========================================================================
# Fleet DispatchGuard .gitignore
#
# Organized by category. Each section explains WHY the patterns exist —
# security/compliance risk, collaboration noise, or repository hygiene.
#
# See docs/DEVELOPMENT.md ("Sensitive Files & .gitignore") for the full
# rationale and for how to override an exclusion when you genuinely need
# to commit a matched file.
#
# SPEC: specs/completed/0010_SPEC_RobustGitignoreConfiguration.md
#========================================================================

#------------------------------------------------------------------------
# Build Artifacts (.NET / C#)
# Regenerated by `dotnet build`; committing them bloats history and
# causes stale-binary conflicts between developers.
#------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
*.dll
*.exe

#------------------------------------------------------------------------
# NuGet & Package Artifacts
# Package cache/restore output; dependencies are reproducible from the
# .csproj/.slnx files, so there is nothing to gain from tracking these.
#------------------------------------------------------------------------
*.nupkg
*.snupkg
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

#------------------------------------------------------------------------
# ASP.NET Scaffolding
#------------------------------------------------------------------------
ScaffoldingReadMe.txt

#------------------------------------------------------------------------
# Sensitive Configuration
# CRITICAL: these files carry connection strings, API keys, or other
# environment-specific secrets. Once committed, a secret stays in git
# history permanently even after later deletion — this is the single
# highest-severity category in this file. `appsettings.json` (the base
# template with no secrets) is intentionally NOT matched: only files
# with an extra segment (Development/Production/local/etc.) are.
#------------------------------------------------------------------------
appsettings.*.json
!appsettings.json
*.secrets.json
*.private.json
**/secrets/
**/credentials/
**/*credentials*

#------------------------------------------------------------------------
# Environment Variables
# CRITICAL: local overrides of env vars frequently hold DB passwords,
# JWT signing keys, or third-party API tokens.
#------------------------------------------------------------------------
.env
.env.local
.env.*.local

#------------------------------------------------------------------------
# IDE & Editor — Visual Studio
# User-specific cache/settings; committing them creates PR noise and can
# leak local filesystem paths.
#------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.private*

#------------------------------------------------------------------------
# IDE & Editor — JetBrains (Rider / IntelliJ)
#------------------------------------------------------------------------
.idea/
*.iml
.idea_modules/

#------------------------------------------------------------------------
# IDE & Editor — VS Code
# Only the user's personal settings override is ignored; shared
# workspace recommendations (extensions.json, launch.json) may still be
# committed intentionally by the team.
#------------------------------------------------------------------------
.vscode/settings.json.user

#------------------------------------------------------------------------
# OS-Generated Files
# Metadata created by the OS file browser, not part of the project.
#------------------------------------------------------------------------
.DS_Store
.TemporaryItems/
Thumbs.db
$RECYCLE.BIN/
*.lnk

#------------------------------------------------------------------------
# Test & Coverage Artifacts
# Output of a test *run*, not source — regenerated every `dotnet test`.
#------------------------------------------------------------------------
[Tt]est[Rr]esult*/
coverage/
CodeCoverage/
*.trx
*.VisualState.xml
TestResult.xml
nunit-*.xml

#------------------------------------------------------------------------
# Docker
# docker-compose.override.yml holds a developer's local overrides
# (ports, volumes); it must never dictate another dev's environment.
#------------------------------------------------------------------------
docker-compose.override.yml

#------------------------------------------------------------------------
# Backup / Temporary / Editor Swap Files
#------------------------------------------------------------------------
~$*
*~
*.bak
*.swp
*.swo
.#*
*#

#------------------------------------------------------------------------
# MSBuild Logs
#------------------------------------------------------------------------
*.binlog
[Bb]uild[Ll]og.*

#------------------------------------------------------------------------
# SQL Scripts (local scratch scripts, not migrations)
#------------------------------------------------------------------------
*.sql
# Part of the deployment (SPEC 0091).
!deploy/sql/*.sql

#------------------------------------------------------------------------
# Claude Code (local session state)
# worktrees/ holds full ephemeral repo copies created per agent session —
# committing one would duplicate the entire repo, including its own
# nested appsettings/bin/obj. settings.local.json is a personal override
# (local permission grants); launch.json and settings.json (without
# ".local") are shared team config and stay tracked intentionally.
#------------------------------------------------------------------------
.claude/worktrees/
.claude/settings.local.json

#========================================================================
# Override Instructions
#
# If you genuinely need to commit a file matched above (e.g. a local
# fixture that should be reproducible for the team), force-add it
# explicitly and explain why in the commit message:
#
#   git add -f path/to/file.txt
#   git commit -m "Add excluded file (justification)"
#
# Example: git add -f Tests/Local/TestDataSeed.json
#========================================================================

# Claude Code: estado del hook de verificación (local)
.claude/.last-verified

# BenchmarkDotNet (SPEC 0039): resultados publicados a mano en docs/benchmarks/
BenchmarkDotNet.Artifacts/

# Playwright (SPEC 0044)
web/test-results/
web/playwright-report/
web/reports/

# Stryker.NET (SPEC 0099): the report is summarised by hand in docs/MUTATION.md
StrykerOutput/
